{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "tailwind.config.js"],
  "exclude": ["node_modules"]
  ,
  "react": {
  "compilerOptions": {
    // Garante que o TypeScript entenda a sintaxe JSX
    "jsx": "react-jsx", 
    
    // Inclui as definições de tipos do React
    "lib": ["dom", "dom.iterable", "esnext"], 
    
    // E garante que as types do React sejam carregadas
    "types": ["react", "react-dom"] 
  }
  }
}